# The dashboard's environment. Copy to .env.local and fill in.
#
# Everything here is PUBLIC. Vite inlines VITE_-prefixed values into the
# JavaScript bundle it ships, so anything set below is readable by anyone who
# opens the deployed page. Never put a value here that is not safe in the open —
# an RPC URL with a provider API key in it is such a value, so restrict it by
# domain at the provider or use a keyless endpoint. Private keys belong in the
# root .env, which is never published.
#
# Read at BUILD time, never at run time. `pnpm run deploy` and the Docker build
# each bake these in, so a deployed Worker or a running container cannot be
# repointed at another chain without rebuilding. For Cloudflare Workers Builds,
# set these as Build Variables for both Preview and Production; Worker runtime
# Variables & Secrets and `wrangler.jsonc` `vars` cannot populate Vite builds.
#
# The registry address is deliberately not here — it comes from
# deployments/arc-testnet.json. A value nobody changes per environment is not
# configuration.

# Set this and the dashboard reads Arc directly. Unset, it serves seeded demo
# data and says so in its own header, rather than an empty marketplace.
VITE_ARC_RPC_URL=

# Resolving each service's ENS records. Only used once VITE_ARC_RPC_URL is set.
VITE_SEPOLIA_RPC_URL=

# Where the landing page's two forms post. This site has no backend and is not
# getting one, so each is the submit URL of a third-party form service —
# Formspree, Buttondown, Tally or similar — that accepts a JSON POST and
# answers a rejection as JSON. A submit URL is safe in the open; nothing else
# about that account is, so do not put an API key here.
#
# Unset, the forms do not pretend: they render disabled, say no endpoint is
# configured in this build, and point at the repository instead. That is the
# honest state, so leaving these blank is a valid deployment.
VITE_NEWSLETTER_ENDPOINT=
VITE_CONTACT_ENDPOINT=
