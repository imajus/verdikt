# Only things that differ per environment go here — RPC URLs, keys, ports,
# timeouts. Contract addresses and other constants live in deployments/*.json
# (checked in) or in code (scripts/ens-sepolia.mjs, packages/sdk/*).
#
# Other env files, each read only from its own root: web/.env.example
# (dashboard build-time vars), cre/workflows/.env.example (CRE CLI key),
# runner/.env.example (simulate-mode gateway).

# =============================================================================
# Arc Testnet — registry, escrow, verdicts, refunds, x402 payment (§3)
# =============================================================================

ARC_RPC_URL=
# Optional. Default: deployments/arc-testnet.json. Set only for a fork or a
# second deployment.
VERDIKT_REGISTRY_ADDRESS=
VERDIKT_REGISTRY_DEPLOY_BLOCK=

# =============================================================================
# Ethereum Sepolia — ENSv2 identity / SLA layer (§4)
# =============================================================================

SEPOLIA_RPC_URL=

# All other Sepolia addresses (operator, subname registry, resolver, score
# writer, subname registrar) live in deployments/sepolia.json.

# =============================================================================
# Chainlink CRE
# =============================================================================

# Required by both deploy scripts (Deploy.s.sol, DeployScoreWriter.s.sol).
# Report header field, bytes 87..107.
#
# Production: `cast wallet new` -> key into cre/workflows/.env as
# CRE_ETH_PRIVATE_KEY -> `cre account link-key -l verdikt` -> `cre account
# list-key`. Currently blocked: `cre whoami` reports Deploy Access not
# enabled.
#
# Simulation (what both live deployments use today): `cre workflow simulate`
# sends the placeholder 0xaAaA…aAaa as owner. Use that value.
CRE_WORKFLOW_OWNER=

# Optional pin: first 10 UTF-8 bytes of workflow-name (verdikt-verify,
# verdikt-aggregate). LEAVE EMPTY for `cre workflow simulate` — it sends a
# random name per run, and pinning the real name makes the forwarder swallow
# every report silently. Only set for a production deployment.
CRE_WORKFLOW_NAME=

# Optional. Defaults to each chain's production KeystoneForwarder. Simulation
# needs the simulation forwarder instead: Arc
# 0x6E9EE680ef59ef64Aa8C7371279c27E496b5eDc1, Sepolia 0x15fC6ae9… (per-chain,
# not interchangeable — the wrong one also fails silently).
CRE_FORWARDER_ADDRESS=
CRE_SEPOLIA_FORWARDER=

# --- Triggering the deployed verify workflow from the proxy.
# All four required, or the proxy refuses paid calls rather than relay them
# unverified.

# Today: @verdikt/runner's stand-in gateway, https://<runner-host>/workflows/execute.
# Production: Chainlink's gateway — public
# https://01.gateway.zone-a.cre.chain.link, private
# https://01.enterprise-gateway.zone-a.cre.chain.link/.
CRE_TRIGGER_URL=

# 64-char workflow id, from `cre workflow hash`.
CRE_WORKFLOW_ID=

# Proxy's own signing key for the gateway JWT (not a static token — minted
# per request). Its address must be in the workflow's authorizedKeys.
CRE_TRIGGER_PRIVATE_KEY=

# Where the workflow POSTs its result. Must be reachable from the workflow;
# the proxy serves it at /internal/verification-callback.
CRE_CALLBACK_URL=

# Shared secret the callback must present. Unset = every callback refused.
# For local simulation, mirror into cre/workflows/.env as
# CRE_CALLBACK_TOKEN_VAR. Production workflows get it from the Vault DON.
CRE_CALLBACK_TOKEN=

PROXY_VERIFY_TIMEOUT_MS=45000

# =============================================================================
# Deploying the contracts
# =============================================================================

# Funded on the target chain. Both scripts read it.
DEPLOYER_PRIVATE_KEY=

# --- VerdiktRegistry on Arc (contracts/script/Deploy.s.sol)
# Native 18-decimal USDC view (msg.value), not the 6-decimal ERC-20. Below:
# 10 USDC bond, 1 USDC refund cap. FIXED_REFUND must be <= DEPOSIT_AMOUNT.
DEPOSIT_AMOUNT=10000000000000000000
FIXED_REFUND=1000000000000000000

# --- VerdiktScoreWriter on Sepolia (contracts/script/DeployScoreWriter.s.sol)
# No config needed; reads deployments/sepolia.json. After deploy, record the
# address there and in cre/workflows/aggregate/config.staging.json.

# --- VerdiktSubnameRegistrar on Sepolia (contracts/script/DeployRegistrar.s.sol)
# Reads deployments/sepolia.json. After deploy: run
# `node scripts/grant-registrar-roles.mjs --send`, then record the address in
# deployments/sepolia.json.

# Optional, default 365 days.
SUBNAME_DURATION_SECONDS=

# =============================================================================
# Keys
# =============================================================================

# EOA scoped to the conformance/availability text records on Sepolia. Used by
# writeServiceScores (seed/ops scripts) and `pnpm spike:ens --live`.
# Production score writes go through VerdiktScoreWriter, not this key.
ENS_SCORE_SIGNER_PRIVATE_KEY=

# Provider's key: scoped to sla/url records on its <slug>.verdikt.eth
# subname, and calls register() on Arc.
PROVIDER_PRIVATE_KEY=

# Key for deployments/sepolia.json's ens.operator. Required by
# `pnpm setup:ens --send`, `pnpm spike:ens --live`, and
# `node scripts/grant-registrar-roles.mjs --send`.
ENS_DEPLOYER_PRIVATE_KEY=

# Paying agent's key, for `node scripts/pay-x402.mjs <url> --send`. Needs
# USDC on the eip3009 challenge's chain; no gas (facilitator submits the
# ERC-3009 transfer). Demo paywall: Base Sepolia USDC
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e. Keep separate from
# PROVIDER_PRIVATE_KEY.
VERDIKT_PAYER_PRIVATE_KEY=

# =============================================================================
# Proxy
# =============================================================================
# Deployed as a Cloudflare Worker: non-secret vars (CRE_TRIGGER_URL,
# CRE_WORKFLOW_ID, CRE_CALLBACK_URL, ARC_RPC_URL, SEPOLIA_RPC_URL) live in
# wrangler.jsonc's `vars`; CRE_TRIGGER_PRIVATE_KEY and CRE_CALLBACK_TOKEN are
# secrets (proxy/.dev.vars locally, `wrangler secret put` for real deploys).
# Below is for running loadConfig() outside Workers (tests, local Node).

PROXY_PUBLIC_HOST=verdikt.bond
PROXY_ENS_CACHE_TTL_MS=30000
PROXY_UPSTREAM_TIMEOUT_MS=30000
# `<chainId>=<url>` pairs, comma-separated. Read only to ask a smart-contract
# account whether it authorized a payment (ERC-1271) — a Circle agent wallet is
# one, and its signature recovers to an owner key rather than to itself, so
# without an RPC for its chain that payment is refused. The chain is the
# provider's choice, named by its own 402, so this is neither of Verdikt's two
# chains. A chain absent here simply cannot have contract payers verified on it.
# The deployed list lives in proxy/wrangler.jsonc and covers every network
# enabled on the Alchemy app. Not mainnet.base.org: it sits behind Cloudflare
# bot management and answers a Worker with a challenge page instead of JSON,
# which this reader can only read as "the account did not validate" — check any
# replacement from a Worker, not from a laptop.
PAYMENT_RPC_URLS=8453=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY,137=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Refuses private/link-local upstream hosts unless true. Only for a demo
# provider on localhost.
PROXY_ALLOW_PRIVATE_UPSTREAM=false

# Only affects payments decodePayment can't verify (Circle's unpublished
# GatewayWalletBatched) — eip3009 payments are verified regardless of this
# flag. When true, an unverifiable payment is credited to a fixture payer
# instead of being refused. Never set true where a real bond is at stake.
VERDIKT_ALLOW_STUB_PAYMENT=false
