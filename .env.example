# What belongs in this file: things that genuinely differ between environments —
# an RPC URL, a private key, a port, a timeout.
#
# What does NOT: contract addresses and other constants. Verdikt's own deployed
# addresses live in `deployments/*.json`, checked in because they are public,
# identical for every developer and for CI, and produced by the deploy scripts.
# Constants of someone else's deployment — the ENSv2 protocol contracts,
# Chainlink's forwarders, Arc's chain id — are code, in
# `scripts/ens-sepolia.mjs`, `packages/sdk/{ens,arc}.js` and the deploy scripts.
#
# The rule behind both: a value nobody can change per environment is not
# configuration, and putting it here makes it a thing every contributor has to
# be handed out of band, that nothing validates, and that can silently disagree
# with the code.

# =============================================================================
# Arc Testnet — registry, escrow, verdicts, refunds, and the x402 payment (§3)
# =============================================================================

ARC_RPC_URL=
# Both optional. The registry address and its deploy block come from
# deployments/arc-testnet.json; set these only to point at a fork or a second
# deployment.
VERDIKT_REGISTRY_ADDRESS=
VERDIKT_REGISTRY_DEPLOY_BLOCK=

# =============================================================================
# Ethereum Sepolia — the ENSv2 identity / SLA layer (§4)
# =============================================================================

SEPOLIA_RPC_URL=

# Nothing else. The parent name, the account that operates its resolver, and
# Verdikt's deployed proxies (the subname registry and the shared resolver) are
# in deployments/sepolia.json — public, identical everywhere, and produced by
# `pnpm setup:ens`, which prints what to record there. ENSv2's own protocol
# addresses are constants in scripts/ens-sepolia.mjs. `pnpm spike:ens
# --read-only` prints live state for both.

# =============================================================================
# Chainlink CRE
# =============================================================================
#
# A workflow holds no key and sends no transaction. It ABI-encodes a payload,
# has the DON sign it into a report, and a KeystoneForwarder delivers it to an
# IReceiver (Spike B, CRE-2). So there is no signer EOA anywhere below — the
# on-chain role is the forwarder address plus the workflow owner pinned in the
# report header.

# The address that owns the deployed workflow, as it appears in the report
# header (bytes 87..107). REQUIRED by both deploy scripts: the forwarder is
# shared infrastructure, so without this pin any CRE user could write Verdikt's
# verdicts and publish Verdikt's reputation scores.
#
# HOW TO GET IT. It is not issued to you — it is an EVM address you nominate and
# then link to your CRE account:
#
#     cast wallet new                        # a fresh burner; Foundry
#     # put its key in cre/workflows/.env as CRE_ETH_PRIVATE_KEY
#     cre account link-key -l verdikt        # signs with that key, links it
#     cre account list-key                   # confirm; this is the owner address
#
# `cre account list-key` currently reports none linked, and `cre whoami` shows
# "Deploy Access: Not enabled" — the private-beta gate. Until both change, this
# stays empty and no workflow can be deployed. Plain `cre workflow simulate`
# needs neither.
CRE_WORKFLOW_OWNER=

# Optional extra pin, checked only if non-empty: the first 10 bytes of the
# workflow name, from `workflow-name` in each workflow.yaml — currently
# "verdikt-verify" and "verdikt-aggregate".
#
# Set the FULL name, not a truncation. The header field is 10 raw UTF-8 bytes
# (confirmed against the SDK's parser, spike finding CRE-8), and Solidity's
# bytes10() truncates identically, so "verdikt-verify" matches "verdikt-ve" on
# both sides. Note the two workflows differ within those ten bytes, so each
# receiver pins its own name: the registry wants verdikt-verify, the score
# writer verdikt-aggregate.
CRE_WORKFLOW_NAME=

# Optional. Chainlink's forwarders are constants of their deployment, so both
# deploy scripts default to the right one for their chain. Override only to
# target the simulation forwarder (`cre workflow simulate --broadcast` on Arc
# Testnet uses 0x6E9EE680ef59ef64Aa8C7371279c27E496b5eDc1) or another network.
CRE_FORWARDER_ADDRESS=
CRE_SEPOLIA_FORWARDER=

# --- Triggering the deployed `verdikt-verify` workflow from the proxy.
#
# The proxy triggers the workflow and then waits: the trigger response carries
# only `{status: "ACCEPTED", workflow_execution_id}` (CRE-3), and no endpoint
# for reading an execution's result is documented at all (CRE-9). So the
# workflow pushes its result back to CRE_CALLBACK_URL from inside the enclave,
# correlated by requestId. That round trip is demonstrated in
# docs/evidence/cre-callback-roundtrip.log.
#
# All four must be set or the proxy refuses paid calls rather than relaying them
# unverified.

# The gateway. `https://01.gateway.zone-a.cre.chain.link` for a public (onchain)
# registry; `https://01.enterprise-gateway.zone-a.cre.chain.link/` for a private
# one. Speaks JSON-RPC: method `workflows.execute`.
CRE_TRIGGER_URL=

# The 64-character workflow id, from `cre workflow hash`. Goes in
# `params.workflow.workflowID`.
CRE_WORKFLOW_ID=

# The proxy's OWN key — not a token. The gateway wants a Bearer JWT whose
# payload digests the exact request body, so it has to be minted per request;
# the proxy signs one with this. Its address must appear in the workflow's
# `authorizedKeys`, which is what stops a third party manufacturing verdicts by
# calling the workflow directly (CRE-4). Distinct from any payment key: Verdikt
# still holds no wallet on the payment leg.
CRE_TRIGGER_PRIVATE_KEY=

# Where the enclave pushes the finished verification. Must be reachable from the
# workflow, and is the URL the proxy is serving `/internal/verification-callback`
# on.
CRE_CALLBACK_URL=

# Shared secret the enclave presents on that callback. Unset means the proxy
# refuses every callback, so a paid call times out rather than being answered by
# anyone who can reach the port. The same value goes in the workflow's config
# (`callbackToken` in cre/workflows/verify/config.staging.json) — it belongs in
# secrets.yaml once that is wired, because it authenticates bytes that reach a
# paying agent.
CRE_CALLBACK_TOKEN=

# How long the proxy waits for that callback before giving up. The agent has
# paid, so a timeout is surfaced as a distinct 504, never swallowed.
PROXY_VERIFY_TIMEOUT_MS=45000

# =============================================================================
# Deploying the contracts
# =============================================================================

# Funded on whichever chain you are deploying to. Both scripts read it.
DEPLOYER_PRIVATE_KEY=

# --- VerdiktRegistry on Arc (contracts/script/Deploy.s.sol, Tasks.md 2.4)
#
# Bond and refund are in Arc's 18-decimal NATIVE view — they move as msg.value.
# Arc exposes the same USDC twice: 18 decimals natively (gas, msg.value) and 6
# as the ERC-20 at 0x3600...0000, which is the view x402 payments and the SLA
# price clause use. They differ by 1e12, and VerdiktRegistry converts between
# them. Below: 10 USDC bond, 1 USDC per-call refund cap.
# FIXED_REFUND must be <= DEPOSIT_AMOUNT.
DEPOSIT_AMOUNT=10000000000000000000
FIXED_REFUND=1000000000000000000

# --- VerdiktScoreWriter on Sepolia (contracts/script/DeployScoreWriter.s.sol)
#
# Needs nothing here. It reads the resolver and the parent name from
# deployments/sepolia.json and derives the parent node from the name with
# EnsNamehash, so no setting can disagree with another. Record the deployed
# address back in that file, and copy it into
# cre/workflows/aggregate/config.staging.json — CRE workflows are configured by
# that file, not by the environment.

# =============================================================================
# Keys
# =============================================================================

# An EOA scoped to the `conformance` / `availability` text records on Sepolia.
#
# It is NOT how scores reach ENS in production — VerdiktScoreWriter holds those
# EAC roles and calls setText itself. This key is the out-of-band path:
# `writeServiceScores` in @verdikt/sdk for seed and operational scripts, and the
# actor `pnpm spike:ens --live` uses to prove the per-key ACL, by writing `sla`
# with it and watching it revert.
#
# Was VERIFIER_PRIVATE_KEY, a name that outlived its meaning twice: Spike B took
# the Arc verdict write away from it, and VerdiktScoreWriter took the ENS write.
ENS_SCORE_SIGNER_PRIVATE_KEY=

# A provider's own key: scoped to the `sla` and `url` records on its
# <slug>.verdikt.eth subname, and the account that calls register() on Arc.
# `pnpm spike:ens --live` uses it as the other half of the ACL assertion — it
# writes `sla` and reverts on `conformance`.
PROVIDER_PRIVATE_KEY=

# The key for ENS_OPERATOR_ADDRESS. Sepolia-only, and a wallet created for this
# and nothing else — the proxy salt mixes msg.sender, so `pnpm setup:ens --send`
# refuses to broadcast if this key is not the operator. Needed by
# `pnpm setup:ens --send` and `pnpm spike:ens --live`.
ENS_DEPLOYER_PRIVATE_KEY=

# The paying AGENT's key, for `node scripts/pay-x402.mjs <url> --send` — the one
# remaining step of Spike C (Tasks.md 0.4).
#
# It needs USDC on the chain of the challenge's eip3009 option, and nothing
# else: no gas, because the x402 facilitator submits the ERC-3009 transfer, and
# no Circle wallet, because that scheme is an open standard. For the demo
# paywall that is Base Sepolia USDC at
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e, and the charge is 1 minor unit
# ($0.000001), so any dust will do.
#
# Deliberately separate from PROVIDER_PRIVATE_KEY: the whole point of the
# verdict is that the payer and the provider are different parties.
VERDIKT_PAYER_PRIVATE_KEY=

# =============================================================================
# Proxy
# =============================================================================

PROXY_PORT=8402
PROXY_HOST=0.0.0.0
PROXY_PUBLIC_HOST=verdikt.bond
PROXY_ENS_CACHE_TTL_MS=30000
PROXY_UPSTREAM_TIMEOUT_MS=30000
LOG_LEVEL=info
# A provider authors its own `url` ENS record and the proxy dials it from
# Verdikt's network, so private and link-local hosts are refused. Only turn this
# on for a demo provider on localhost.
PROXY_ALLOW_PRIVATE_UPSTREAM=false

# Spike C (Tasks.md 0.4) has not run, so `decodePayment` is a stub that returns
# the FIXTURE payer for any header. It refuses to run unless this is set, so a
# misdirected refund is a loud startup failure instead of a silent one. Never
# set it anywhere a real bond is at stake.
VERDIKT_ALLOW_STUB_PAYMENT=false

# =============================================================================
# Demo provider (Proceeds paywall wrapping Open-Meteo)
# =============================================================================
#
# Not wired to anything yet: the live provider is Tasks.md 6.1, which is blocked
# on the Arc deployment. `pnpm demo` needs none of this — it runs the whole loop
# against a throwaway anvil.
DEMO_PROVIDER_BASE_URL=
