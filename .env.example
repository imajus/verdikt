# --- Arc Testnet: registry, escrow, verdicts, refunds, x402 payment (spec §3)
ARC_RPC_URL=
ARC_CHAIN_ID=5042002
VERDIKT_REGISTRY_ADDRESS=

# --- VerdiktRegistry deployment (contracts/script/Deploy.s.sol, Tasks.md 2.4)
# The KeystoneForwarder that delivers CRE reports. A workflow holds no key and
# sends no transaction, so this — not a verifier EOA — is the on-chain role
# (Spike B, CRE-2). Arc Testnet: production forwarder below; the simulation
# forwarder used by `cre workflow simulate --broadcast` is
# 0x6E9EE680ef59ef64Aa8C7371279c27E496b5eDc1.
CRE_FORWARDER_ADDRESS=0x76c9cf548b4179F8901cda1f8623568b58215E62
# The CRE account whose workflow may write verdicts. REQUIRED: the forwarder is
# shared infrastructure, so without this any CRE user on Arc could write Verdikt
# verdicts. Checked against the report header, in addition to msg.sender.
CRE_WORKFLOW_OWNER=
# Optional extra pin on the workflow name (first 10 bytes). Leave empty to skip.
CRE_WORKFLOW_NAME=
# Native USDC minor units (6 decimals). FIXED_REFUND must be <= DEPOSIT_AMOUNT.
DEPOSIT_AMOUNT=10000000
FIXED_REFUND=1000000
DEPLOYER_PRIVATE_KEY=

# --- Ethereum Sepolia: ENSv2 identity / SLA layer (spec §4)
SEPOLIA_RPC_URL=
# Registered on Sepolia ENSv2 (Spike A), with its resolver and subregistry
# deployed by `pnpm setup:ens`. No <slug>.verdikt.eth exists until onboarding
# runs — see docs/spikes/A-ens-sepolia.md. `pnpm spike:ens --read-only` prints
# live state.
ENS_PARENT_NAME=verdikt.eth

# Protocol contracts, confirmed on-chain by Spike A (Tasks.md 0.2). Fixed for
# the ENSv2 Beta deployment; `pnpm spike:ens --read-only` re-verifies them.
ENS_ETH_REGISTRY_ADDRESS=0xbdc85dd5b15d7ecb354cd7cb6f2c50b4f2c4f0e2
ENS_UNIVERSAL_RESOLVER_ADDRESS=0x4a1817d13e9cf196f471725176355c1234b63c70
ENS_VERIFIABLE_FACTORY_ADDRESS=0x10dc6333cdfe1fcef624c6e0a8221b91804cd7ef
ENS_PERMISSIONED_RESOLVER_IMPL_ADDRESS=0x9eae5c2730a7dd16bdd1dee6421a1b91e3b0365e
ENS_USER_REGISTRY_IMPL_ADDRESS=0x624a25d67b59d587752ebec8dded8827dae52050

# The account that owns ENS_PARENT_NAME and operates its resolver. Resolver
# roles are per-account and do NOT move when the name is transferred, so this
# is a deliberate choice, not a consequence of ownership (Spike A).
ENS_OPERATOR_ADDRESS=0x4088f83b25Ff1dcc8bd1D88250e316ed5AB29AEE

# Verdikt's own proxies, deployed once through the VerifiableFactory: the
# subname registry under ENS_PARENT_NAME, and the per-account resolver every
# <slug>.verdikt.eth shares. `pnpm setup:ens` deploys both and prints them; a
# re-run against a namespace already set up reports nothing to do.
ENS_SUBNAME_REGISTRY_ADDRESS=0x3618849F8B562DcC9D25dCbA67cF0be5C8213A97
ENS_RESOLVER_ADDRESS=0x3d411f1bA3B11B630a2405F1Fb51f088Cc2E23C9

# --- Keys
# Verifier = the CRE workflow's signer on the ENS side. Since Spike B this is
# NOT the address that writes verdicts on Arc — those arrive as DON-signed
# reports through CRE_FORWARDER_ADDRESS above. What remains scoped to this key
# is the conformance / availability text records on Sepolia.
VERIFIER_PRIVATE_KEY=
PROVIDER_PRIVATE_KEY=
# The key for ENS_OPERATOR_ADDRESS. Sepolia-only, and a wallet created for this
# and nothing else — the proxy salt mixes msg.sender, so `pnpm setup:ens --send`
# refuses to broadcast if this key is not the operator. Needed by
# `pnpm setup:ens --send` and `pnpm spike:ens --live`.
ENS_DEPLOYER_PRIVATE_KEY=

# --- Proxy
PROXY_PORT=8402
PROXY_PUBLIC_HOST=verdikt.bond

# --- Demo provider (Proceeds paywall wrapping Open-Meteo)
DEMO_PROVIDER_BASE_URL=
