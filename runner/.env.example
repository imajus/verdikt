# Copy to .env for local development (node --env-file=.env src/server.js), or
# provision these as container environment variables. The runner passes its
# environment through to its `cre workflow simulate` child, so it does not
# require cre/workflows/.env. Never commit a filled-in copy of this file.
# See README.md for the CRE login-session mount, which is not an env variable.

# Required. The address that must have signed the proxy's trigger JWT
# (proxy's CRE_TRIGGER_PRIVATE_KEY, mirrored here as the address it derives
# to — never the private key itself). Get it with:
#   node -e "console.log(require('@verdikt/sdk/signing').addressOf(process.env.CRE_TRIGGER_PRIVATE_KEY))"
# run against the proxy's own key, not this file.
RUNNER_TRIGGER_ADDRESS=

# Port this service listens on for the proxy's trigger calls.
RUNNER_PORT=8787

# Max age (seconds) a trigger JWT is accepted for, mirroring the proxy's
# MAX_TTL_SECONDS (proxy/src/jwt.js).
RUNNER_JWT_MAX_AGE_SECONDS=300

# Where the `cre workflow simulate --listen` process's HTTP trigger endpoint
# is. Only change this if the simulator is not co-located with the runner.
RUNNER_SIMULATOR_URL=http://127.0.0.1:2000/trigger

# How long to wait for the simulator to acknowledge a forwarded trigger
# before treating it as "still running" rather than failed. See README.md
# "Known unknowns" — /trigger's blocking behavior is undocumented.
RUNNER_TRIGGER_ACK_TIMEOUT_MS=5000

# Maximum bytes accepted for a single trigger request. This limit is enforced
# while streaming, before the unauthenticated body is parsed or verified.
RUNNER_MAX_REQUEST_BODY_BYTES=1048576

# The CRE project directory (holding project.yaml) the simulator is run from.
# Inside the Docker image this is /app/cre/workflows.
RUNNER_WORKFLOW_DIR=/app/cre/workflows

# Which `cre` project.yaml target to simulate against.
RUNNER_CRE_TARGET=staging-settings

# Which workflow under RUNNER_WORKFLOW_DIR to run --listen for.
RUNNER_WORKFLOW_NAME=verify

# If "true", passes --broadcast to `cre workflow simulate`, performing a real
# onchain write per verified request. Requires CRE_ETH_PRIVATE_KEY below. Leave
# "false" until you specifically want on-chain verdicts written by this host.
RUNNER_CRE_BROADCAST=false

# Passed through to the CRE child process. Required only with broadcast: a
# funded Arc Testnet burner key used by `cre workflow simulate --broadcast`.
CRE_ETH_PRIVATE_KEY=

# Passed through to the CRE child process and mapped to the verify workflow's
# CALLBACK_TOKEN secret. Set it to the same value as the proxy's
# CRE_CALLBACK_TOKEN. Required whenever the workflow must call callbackUrl.
CRE_CALLBACK_TOKEN_VAR=

# How long to wait after spawning the simulator before accepting triggers, if
# its stdout never matches the readiness heuristic (see README.md).
RUNNER_SIMULATOR_WARMUP_MS=15000

# Optional. If set, the runner rejects any trigger naming a different
# params.workflow.workflowID than this — must match the proxy's
# CRE_WORKFLOW_ID (proxy/wrangler.jsonc) if you turn this check on.
RUNNER_WORKFLOW_ID=
