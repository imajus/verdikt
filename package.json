{
  "name": "verdikt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Verified x402 API marketplace — SLA conformance verified in a TEE, refunds enforced on-chain",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "contracts:build": "pnpm --filter @verdikt/contracts build",
    "contracts:test": "pnpm --filter @verdikt/contracts test",
    "spike:ens": "node --env-file-if-exists=.env scripts/spike-ens.mjs",
    "setup:ens": "node --env-file-if-exists=.env scripts/setup-ens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
