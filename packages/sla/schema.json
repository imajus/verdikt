{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdikt.bond/schema/sla-v1.json",
  "title": "Verdikt SLA v1",
  "description": "The provider-authored document stored verbatim in the `sla` ENS text record on <slug>.verdikt.eth. Validated by @verdikt/sla's own JSON Schema subset, so this file is executable rather than documentation that can drift.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "clauses"],
  "properties": {
    "version": { "const": 1 },
    "clauses": {
      "description": "At least one. An empty clause list would make every call PASS, including a 5xx, which is why it is rejected rather than treated as 'promises nothing'.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "title": "schema clause",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "schema"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "description": { "type": "string", "maxLength": 256 },
              "type": { "const": "schema" },
              "schema": { "type": "object" }
            }
          },
          {
            "title": "latency clause",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "maxMs"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "description": { "type": "string", "maxLength": 256 },
              "type": { "const": "latency" },
              "maxMs": { "type": "integer", "minimum": 0, "maximum": 600000 }
            }
          },
          {
            "title": "priceRange clause",
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "minMinorUnits", "maxMinorUnits", "asset"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "description": { "type": "string", "maxLength": 256 },
              "type": { "const": "priceRange" },
              "minMinorUnits": {
                "description": "Decimal integer string. JSON has no bigint and a float would break the integer-only comparison the spec requires.",
                "type": "string",
                "minLength": 1,
                "maxLength": 78
              },
              "maxMinorUnits": { "type": "string", "minLength": 1, "maxLength": 78 },
              "asset": { "type": "string", "minLength": 1, "maxLength": 16 }
            }
          }
        ]
      }
    }
  }
}
