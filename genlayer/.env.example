# genlayer/.env — read by scripts/deploy.py, and by gltest for the networks that
# need an account. The repo root's .env is read first; anything here wins only
# where the root does not set it.
#
# Nothing here is VITE_-prefixed and nothing here reaches a browser bundle. This
# is a deploy key.

# A plain secp256k1 private key, 0x-prefixed. The account behind it needs test
# GEN to deploy: https://testnet-faucet.genlayer.foundation/ gives 100 GEN a
# week, and asks for a signed-in wallet holding at least 0.01 ETH on mainnet.
GENLAYER_PRIVATE_KEY=

# Where the judge fetches SLAs and evidence from. Defaults to the workers.dev
# host, which is the one CRE_CALLBACK_URL already points at.
PROXY_BASE_URL=
