{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verdikt-proxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-07",
  // node:crypto (createHash, randomUUID, randomBytes, timingSafeEqual) and
  // Buffer, used by jwt.js and router.js's constant-time bearer check.
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "PENDING_VERIFICATION", "class_name": "PendingVerification" }]
  },
  // Non-secret config, read by loadConfig (proxy/src/config.js) the same way
  // `.env` is. `CRE_TRIGGER_PRIVATE_KEY` and `CRE_CALLBACK_TOKEN` are NOT
  // here — those are credentials, set with `wrangler secret put`. An empty
  // string is treated as unset (packages/sdk/env.js), same as a bare key in
  // `.env.example`, so the code-level default still applies until filled in.
  "vars": {
    // All three required together, or the paid leg refuses every call rather
    // than relaying one unverified — see CLAUDE.md.
    "CRE_TRIGGER_URL": "https://cre.verdikt.bond/workflows/execute",
    "CRE_WORKFLOW_ID": "95cc8a72edef7b3e04db4ed0f9f605bd99e8ad00ae8814c86857d3e1002bd067",
    // This Worker's own public URL, `/internal/verification-callback` —
    // where the enclave pushes a finished verification back to.
    "CRE_CALLBACK_URL": "https://verdikt-proxy.denis-perov.workers.dev/internal/verification-callback",
    // Arc's public default RPC has no embedded credential, so it's fine here.
    "ARC_RPC_URL": "https://arc-testnet.g.alchemy.com/v2/alch_Ycps6R4vs7fy-PQA7Tz9d",
    // Same Alchemy key `web/.env.local` already bakes into the dashboard's
    // public bundle (CLAUDE.md), so it's no more exposed here than it already
    // is there.
    "SEPOLIA_RPC_URL": "https://eth-sepolia.g.alchemy.com/v2/alch_Ycps6R4vs7fy-PQA7Tz9d",
    // Not Verdikt's chains: these are the chains *providers* ask to be paid on,
    // named by their own 402. Read only to ask a smart-contract account whether
    // it authorized a payment (ERC-1271) — a Circle agent wallet is one, so
    // without this its payments are refused as unverifiable. Public endpoints
    // with no embedded credential, same rationale as ARC_RPC_URL above; swap in
    // keyed ones if the rate limit ever bites.
    "PAYMENT_RPC_URLS": "8453=https://mainnet.base.org,137=https://polygon-rpc.com"
  },
  "migrations": [
    // SQLite-backed: this class uses no `state.storage` at all — every
    // object is in-memory for the life of one verification — but the
    // storage backend still has to be declared, and SQLite is what a
    // Workers Free plan can run.
    { "tag": "v1", "new_sqlite_classes": ["PendingVerification"] }
  ],
  "routes": [{ "pattern": "*.verdikt.bond/*", "zone_name": "verdikt.bond" }],
  // Explicit, not left to wrangler's default: unset here means a plain
  // `wrangler deploy` silently disables the workers.dev subdomain — and
  // CRE_CALLBACK_URL above points straight at it. Disabled, that hostname
  // answers everything with Cloudflare's error 1042, and the CRE workflow's
  // callback POST silently never lands (confirmed live: one deploy without
  // this field undid a working setup and broke the callback again).
  "workers_dev": true
}
